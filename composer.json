{
    "name": "arismarioneves/hpanel",
    "description": "Dashboard moderno para o hPanel da Hostinger",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": { "psr-4": { "HPanel\\": "lib/" } },
    "autoload-dev": { "psr-4": { "HPanel\\Tests\\": "tests/" } },
    "config": { "sort-packages": true }
}
